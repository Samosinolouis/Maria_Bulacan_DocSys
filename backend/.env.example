# ============================================================
# Santa Maria Bulacan DMS — Environment Configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Defaults below match the LOCAL docker-compose stack (repo root):
#   docker compose up -d        # postgres + keycloak + minio
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:4000

# --- PostgreSQL ---
# Shared database: the API owns the `app` schema, Keycloak owns `public`.
# Drizzle qualifies every table as "app"."<table>", so no search_path needed.
DATABASE_URL=postgres://docsys:docsys_dev_pw@localhost:5432/docsys

# --- Keycloak (OIDC) — authentication ONLY, no passwords in app DB ---
# Realm `docsys` + client `docsys-backend` are auto-imported on first boot
# from infra/keycloak/docsys-realm.json.
KEYCLOAK_REALM_URL=http://localhost:8080/realms/docsys
KEYCLOAK_CLIENT_ID=docsys-backend
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/docsys/protocol/openid-connect/certs

# --- MinIO object storage (S3-compatible) — upload-only, server-side credentials ---
# Local dev points at the MinIO service in docker-compose.yml; the bucket
# `docsys-attachments` is created by the `minio-init` job on first boot.
# For any non-local deployment, point these at your MinIO server.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=docsys-attachments
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
# Presigned download URL lifetime (seconds) — [NFR-06]
MINIO_PRESIGN_EXPIRY_SECONDS=900

# --- Upload policy ---
# Comma-separated MIME whitelist (schema.txt: PDF, DOCX, XLSX)
UPLOAD_ALLOWED_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
UPLOAD_MAX_BYTES=26214400

# --- RA 11032 SLA policy ---
# Requests within this many hours of their deadline are "at risk" (FR-38).
SLA_WARNING_HOURS=24

# --- Browser access (CORS) ---
# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Infrastructure toggles (feature flags) ---
TELEMETRY_ENABLED=true
CACHE_ENABLED=false

# ============================================================
# Santa Maria Bulacan DMS — Environment Configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:4000

# --- PostgreSQL (single VM hosts app + DB) ---
DATABASE_URL=postgres://docsys:password@localhost:5432/docsys

# --- Keycloak (OIDC) — authentication ONLY, no passwords in app DB ---
KEYCLOAK_REALM_URL=http://localhost:8080/realms/docsys
KEYCLOAK_CLIENT_ID=docsys-backend
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/docsys/protocol/openid-connect/certs

# --- Backblaze B2 (object storage) — upload-only, server-side credentials ---
B2_APPLICATION_KEY_ID=change-me
B2_APPLICATION_KEY=change-me
B2_BUCKET_NAME=docsys-attachments
B2_BUCKET_ID=change-me
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
# Presigned download URL lifetime (seconds) — [NFR-06]
B2_PRESIGN_EXPIRY_SECONDS=900

# --- Upload policy ---
# Comma-separated MIME whitelist (schema.txt: PDF, DOCX, XLSX)
UPLOAD_ALLOWED_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
UPLOAD_MAX_BYTES=26214400

# --- Infrastructure toggles (feature flags) ---
TELEMETRY_ENABLED=true
CACHE_ENABLED=false

# ============================================================
# Docker Compose overrides — copy to `.env.docker` and edit.
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d
#
# All values have working defaults in docker-compose.yml, so this file
# is optional. NEVER commit `.env.docker` (see .gitignore).
# ============================================================

# --- PostgreSQL (shared by the API and Keycloak) ---
POSTGRES_USER=docsys
POSTGRES_PASSWORD=docsys_dev_pw
POSTGRES_DB=docsys
POSTGRES_PORT=5432

# --- Keycloak ---
KEYCLOAK_PORT=8080
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=docsys-attachments
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
